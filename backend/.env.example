# Backend Environment Configuration (Render Free Tier 512MB RAM)
ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=https://*.vercel.app,http://localhost:3000,*

# Optional: Google Gemini Flash Vision fallback (Not required for core RapidOCR ONNX functionality)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Model settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_IMAGE_DIM=1280
RAM_CEILING_MB=512.0

# Single-core CPU thread limits (Eliminates CPU thrashing on 1 vCPU / 512MB RAM)
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
NUMEXPR_NUM_THREADS=1
